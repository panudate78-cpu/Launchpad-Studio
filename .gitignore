# ----- Dependencies -----
# CRITICAL: never commit node_modules.
# Committing it breaks deployments: the node_modules/.bin/* symlinks are checked
# out without their executable bit, causing "vite: Permission denied" on
# Vercel / Netlify / any Linux CI.
node_modules/
.pnp
.pnp.js

# ----- Build output -----
dist/
dist-ssr/
build/
out/
.vite/
*.local

# ----- Environment -----
.env
.env.*
!.env.example

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Editor / OS -----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----- Caches -----
.cache/
.vercel/
.netlify/
.turbo/
.eslintcache
